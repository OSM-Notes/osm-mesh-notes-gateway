# Serial port for Meshtastic device
SERIAL_PORT=/dev/ttyACM0

# Dry run mode (no DMs sent, no OSM API calls)
DRY_RUN=false

# Disable GPS freshness checks (debug only — do not use in production)
# GPS_VALIDATION_DISABLED=false

# Timezone
TZ=America/Bogota

# Default language for messages (es|en); users can override with #osmlang
# LANGUAGE=es

# Meshtastic LoRa region (gateway radio). Default ANZ = Colombia / several LATAM countries
# (Australia & New Zealand preset). Override for other countries (US, EU_868, BR_902, …).
# LORA_REGION=ANZ

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Daily broadcast (optional, once per calendar day)
DAILY_BROADCAST_ENABLED=false

# Data directory (default: /var/lib/lora-osmnotes)
# DATA_DIR=/var/lib/lora-osmnotes
