msgid "❌ Falta el texto del reporte.\n"
msgstr "❌ Falta el texto del reporte.\n"

msgid "Usa: #osmnote <tu mensaje>\n"
msgstr "Usa: #osmnote <tu mensaje>\n"

msgid "⚠️ No envíes datos personales ni emergencias de cualquier tipo."
msgstr "⚠️ No envíes datos personales ni emergencias de cualquier tipo."

msgid "✅ Reporte recibido y nota creada en OSM.\n"
msgstr "✅ Reporte recibido y nota creada en OSM.\n"

msgid "📝 Nota: #{id}\n"
msgstr "📝 Nota: #{id}\n"

msgid "✅ Reporte recibido. Quedó en cola para enviar cuando haya Internet.\n"
msgstr "✅ Reporte recibido. Quedó en cola para enviar cuando haya Internet.\n"

msgid "📦 En cola: {queue_id}\n"
msgstr "📦 En cola: {queue_id}\n"

msgid "❌ Reporte recibido, pero no hay GPS reciente del dispositivo.\n"
msgstr "❌ Reporte recibido, pero no hay GPS reciente del dispositivo.\n"

msgid "Mantén el T‑Echo encendido al aire libre 30–60 s y reenvía.\n"
msgstr "Mantén el T‑Echo encendido al aire libre 30–60 s y reenvía.\n"

msgid "❌ El dispositivo se prendió hace poco, por lo que la posición no es precisa.\n"
msgstr "❌ El dispositivo se prendió hace poco, por lo que la posición no es precisa.\n"

msgid "Espera {wait_time} segundos más para que el GPS se estabilice y reenvía.\n"
msgstr "Espera {wait_time} segundos más para que el GPS se estabilice y reenvía.\n"

msgid "❌ Las coordenadas GPS recibidas son inválidas.\n"
msgstr "❌ Las coordenadas GPS recibidas son inválidas.\n"

msgid "Verifica que el GPS esté funcionando correctamente.\n"
msgstr "Verifica que el GPS esté funcionando correctamente.\n"

msgid "❌ El mensaje es demasiado largo (máximo {max_len} caracteres).\n"
msgstr "❌ El mensaje es demasiado largo (máximo {max_len} caracteres).\n"

msgid "Acorta el mensaje y reenvía.\n"
msgstr "Acorta el mensaje y reenvía.\n"

msgid "❌ Reporte recibido, pero la última posición es muy vieja (>2 min).\n"
msgstr "❌ Reporte recibido, pero la última posición es muy vieja (>2 min).\n"

msgid "Espera a que el GPS se actualice y reenvía.\n"
msgstr "Espera a que el GPS se actualice y reenvía.\n"

msgid "✅ Reporte recibido (ya estaba registrado).\n"
msgstr "✅ Reporte recibido (ya estaba registrado).\n"

msgid "ℹ️ Comandos disponibles:\n\n"
msgstr "ℹ️ Comandos disponibles:\n\n"

msgid "• #osmnote <mensaje> - Crear nota OSM\n"
msgstr "• #osmnote <mensaje> - Crear nota OSM\n"

msgid "• #osmstatus - Ver estado del gateway\n"
msgstr "• #osmstatus - Ver estado del gateway\n"

msgid "• #osmcount - Ver conteo de notas\n"
msgstr "• #osmcount - Ver conteo de notas\n"

msgid "• #osmlist [n] - Listar últimas notas\n"
msgstr "• #osmlist [n] - Listar últimas notas\n"

msgid "• #osmqueue - Ver tamaño de cola\n"
msgstr "• #osmqueue - Ver tamaño de cola\n"

msgid "• #osmhelp - Esta ayuda\n"
msgstr "• #osmhelp - Esta ayuda\n"

msgid "• #osmmorehelp - Ayuda extendida con detalles\n\n"
msgstr "• #osmmorehelp - Ayuda extendida con detalles\n\n"

msgid "💡 Consejo: Configura #osmnote en Quick Chat.\n"
msgstr "💡 Consejo: Configura #osmnote en Quick Chat.\n"

msgid "Mensajes → menú (3 puntos) → Quick Chat → #osmnote\n"
msgstr "Mensajes → menú (3 puntos) → Quick Chat → #osmnote\n"

msgid "Desactiva 'Instantly send' para que quede 'Append to message'.\n\n"
msgstr "Desactiva 'Instantly send' para que quede 'Append to message'.\n\n"

