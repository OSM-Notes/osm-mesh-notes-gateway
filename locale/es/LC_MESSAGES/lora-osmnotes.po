msgstr "3. Selecciona 'Quick Chat'\n"

msgid "4. Agrega: #osmnote\n"
msgstr "4. Agrega: #osmnote\n"

msgid "5. Desactiva 'Instantly send' para que quede 'Append to message'\n"
msgstr "5. Desactiva 'Instantly send' para que quede 'Append to message'\n"

